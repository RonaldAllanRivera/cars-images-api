# Laravel framework runtime dirs
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*

# Node / Yarn / PNPM logs
npm-debug.log
yarn-error.log
pnpm-debug.log

# Filament compiled assets — regenerated by `php artisan filament:upgrade`
# on every composer install, so they must not be tracked (they cause
# git-pull conflicts on deploy otherwise).
/public/css/filament
/public/js/filament
/public/fonts/filament

# Local-only scratch for deployment credentials — never commit
*.local.txt
deploy-secrets.local.txt

# Machine-specific Claude Code settings (permission rules with absolute paths).
# Project-level plugin overrides live in the tracked .claude/settings.json.
/.claude/settings.local.json

# Expo app (mobile/) - only source is tracked; builds and native
# projects are regenerated by `npx expo` / EAS.
/mobile/node_modules
/mobile/.expo
/mobile/dist
/mobile/android
/mobile/ios
/mobile/.env

# Playwright MCP screenshot scratch
/.playwright-mcp/
