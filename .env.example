APP_NAME="Cars Images API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Docker Compose only (ignored when running without Docker)
#   APP_PORT        host port mapped to the app container
#   FORWARD_DB_PORT host port MySQL is published on, for GUI clients
# ---------------------------------------------------------------------------
APP_PORT=8080
FORWARD_DB_PORT=3307

# DB_HOST=mysql is the Docker Compose service name.
# Running without Docker? Use 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cars_images_api
DB_USERNAME=cars_images_api
DB_PASSWORD=password

# Matches shared-hosting parity: file-based cache/session, synchronous queue.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Enable when the app is served over HTTPS.
# SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Wikimedia Commons  (config/images.php)
#
# WIKIMEDIA_USER_AGENT must identify the deployment and give a real contact
# address. Wikimedia's User-Agent policy rejects generic agents with 429/403.
# ---------------------------------------------------------------------------
WIKIMEDIA_BASE_URL=https://commons.wikimedia.org/w/api.php
WIKIMEDIA_USER_AGENT="CarsImagesApi/1.0 (https://example.com; admin@example.com)"
WIKIMEDIA_TIMEOUT=10
WIKIMEDIA_RETRY_TIMES=5
WIKIMEDIA_RETRY_SLEEP_MS=2000
WIKIMEDIA_CACHE_TTL=86400
WIKIMEDIA_MAXLAG=5

# ---------------------------------------------------------------------------
# Application limits  (config/cars-images.php)
# ---------------------------------------------------------------------------
CSV_IMPORT_MAX_COMBOS=1000
CSV_IMPORT_DEFAULT_IMAGES_PER_YEAR=5
CSV_IMPORT_MAX_UPLOAD_KB=5120
# Hard cap on Wikimedia image downloads one CSV may commit to
# (unique queries x CSV_IMPORT_DEFAULT_IMAGES_PER_YEAR). See config/cars-images.php.
CSV_IMPORT_MAX_PROJECTED_IMAGES=5000

CARS_BULK_RUN_MAX_QUERIES=50
CARS_BULK_RUN_MAX_SECONDS=50
CARS_BULK_RUN_SLEEP_SECONDS=1

CARS_DOWNLOAD_MAX_WIDTH=1600
CARS_DOWNLOAD_JPEG_QUALITY=82
CARS_BULK_DOWNLOAD_MAX_IMAGES=100
