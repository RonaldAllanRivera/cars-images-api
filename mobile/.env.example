# Inlined at build time by Metro - anything prefixed EXPO_PUBLIC_ is public.
# Local: the Laravel dev server. CI injects the production URL for the web build.
#
# After changing this, export with `--clear` (`npx expo export -p web --clear`).
# Metro's cache is not keyed on EXPO_PUBLIC_ values, so a warm cache happily
# serves a bundle carrying the previous run's URL - and a verification step
# that checks the emitted bundle will report a false PASS.
EXPO_PUBLIC_API_URL=http://localhost:8000
