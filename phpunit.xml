<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The suite compiles every Blade view it renders in-process. On a
            cold view cache (a fresh checkout, or right after any composer
            require, whose post-autoload-dump runs filament:upgrade and clears
            it) that compilation plus the 3000x2000 resize in BatchZipBuilderTest
            peaks above PHP's default 128M and dies with "Allowed memory size
            exhausted" in ImageResizer. CI runs with a higher limit and never
            sees it; declare the real requirement so local runs match.
        -->
        <ini name="memory_limit" value="256M"/>
        <env name="APP_ENV" value="testing"/>
        <!--
            Pinned so the contract fixtures capture a stable host. Laravel
            builds the absolute `links.next` and `meta.path` URLs of every
            paginated response from APP_URL, so without this the fixtures
            record whichever host the developer's .env happens to name and
            CI - which writes its .env from .env.example - reads back a diff.
        -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- The CORS tests set their own origins; a developer's or CI's .env must not leak in. -->
        <env name="CORS_ALLOWED_ORIGINS" value=""/>
        <!--
            Wikimedia retry/backoff, pinned for the test suite.
            The real .env uses 5 retries with a 2000ms exponential base, which
            made a single failure-path test sleep for 2+4+8+16 = 30 real seconds.
            Retries are still exercised; they just no longer wait.
        -->
        <env name="WIKIMEDIA_RETRY_TIMES" value="3"/>
        <env name="WIKIMEDIA_RETRY_SLEEP_MS" value="0"/>
    </php>
</phpunit>
